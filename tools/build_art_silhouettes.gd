extends SceneTree
## Measures the opaque pixels of every art crop that Water draws as a solid
## structure and writes scripts/art_silhouettes.gd: for each crop, the left and
## right opaque column of every source row (-1 for an empty row).
## world.gd turns those spans into collision that follows the drawing, so a gap
## that looks open between two machines is open.
##   Godot --headless --path . --script tools/build_art_silhouettes.gd
const StationArt = preload("res://scripts/station_art.gd")
const EnvironmentProps = preload("res://scripts/environment_props.gd")
const District = preload("res://scripts/district_assets.gd")
const OUT := "res://scripts/art_silhouettes.gd"
const ALPHA := 0.5

func _initialize() -> void:
	var sources: Array = []
	for i in StationArt.STRUCTURE_CROPS.size():
		sources.append([StationArt.STRUCTURES.resource_path, StationArt.STRUCTURE_CROPS[i], StationArt.STRUCTURE_CONTOURS.get(i, [])])
	for crop in EnvironmentProps.CROPS:
		sources.append([EnvironmentProps.ATLAS.resource_path, crop, []])
	sources.append([District.ATLAS.resource_path, District.CABINET, []])
	for crop in StationArt.TOTEM_CROPS:
		sources.append([StationArt.TOTEMS.resource_path, crop, []])
	var images := {}
	var text := "extends RefCounted\n## GENERATED by tools/build_art_silhouettes.gd — do not edit by hand.\n"
	text += "## Opaque span of each art crop, per source row: [left, right] pairs\n"
	text += "## relative to the crop (-1, -1 for a fully transparent row).\n\n"
	text += "const SPANS := {\n"
	for source in sources:
		var path: String = source[0]
		var crop: Rect2 = source[1]
		var contour: Array = source[2]
		if not images.has(path):
			images[path] = Image.load_from_file(ProjectSettings.globalize_path(path))
		var image: Image = images[path]
		var polygon := PackedVector2Array(contour)
		var values := PackedStringArray()
		for row in int(crop.size.y):
			var left := -1
			var right := -1
			var y := int(crop.position.y) + row
			for column in int(crop.size.x):
				var x := int(crop.position.x) + column
				if image.get_pixel(x, y).a < ALPHA: continue
				if not polygon.is_empty() and not Geometry2D.is_point_in_polygon(Vector2(x + 0.5, y + 0.5), polygon): continue
				if left < 0: left = column
				right = column
			values.append(str(left))
			values.append(str(right))
		text += "\t\"%s\": [%s],\n" % [key(path, crop), ",".join(values)]
	text += "}\n\n"
	text += "static func key(path: String, crop: Rect2) -> String:\n"
	text += "\treturn \"%s|%d,%d,%d,%d\" % [path, crop.position.x, crop.position.y, crop.size.x, crop.size.y]\n"
	var file := FileAccess.open(OUT, FileAccess.WRITE)
	file.store_string(text)
	file.close()
	print("ART_SILHOUETTES_OK: %d crops" % sources.size())
	quit()

static func key(path: String, crop: Rect2) -> String:
	return "%s|%d,%d,%d,%d" % [path, crop.position.x, crop.position.y, crop.size.x, crop.size.y]
