extends SceneTree
## Imports the painted Core atlases without changing their alpha or source pixels.
const ROOT := "res://assets/core/"
const CITY := "res://assets/prologue/aurora_before.png"
const SHEETS := [
	{"id": "core_boss", "columns": 4, "rows": 4, "height": 158.0},
	{"id": "pillars", "columns": 4, "rows": 1, "height": 106.0},
	{"id": "choice_consoles", "columns": 4, "rows": 1, "height": 76.0},
	{"id": "spark", "columns": 4, "rows": 4, "height": 47.0, "source": "res://assets/power/spark.png"},
]


func _initialize() -> void:
	var all_frames := {}
	for sheet in SHEETS:
		var source_path: String = sheet.get("source", ROOT + sheet.id + ".png")
		var source := Image.load_from_file(source_path)
		if source == null or source.is_empty() or not source.detect_alpha():
			_fail("Missing or opaque atlas " + source_path)
			return
		var frames := _frames(source, sheet)
		if frames.is_empty():
			_fail("Unexpected cell layout in " + source_path)
			return
		all_frames[sheet.id] = frames
	if not _city_variants():
		_fail("City below the tower could not be created")
		return
	var data := JSON.stringify(all_frames, "\t", true, true)
	if not _write(ROOT + "frames.json", data) or not _write(ROOT + "frames.gd",
			"extends RefCounted\n## Generated by tools/import_core_art.gd.\nconst DATA = " + data + "\n"):
		_fail("Could not store the Core atlas frames")
		return
	print("CORE_ART_OK: ", all_frames.size(), " atlases and both city variants")
	quit()


func _frames(source: Image, sheet: Dictionary) -> Array[Dictionary]:
	var columns: int = sheet.columns
	var rows: int = sheet.rows
	var cell_size := Vector2(source.get_size()) / Vector2(columns, rows)
	var regions: Array[Rect2i] = []
	var max_height := 0
	for y in rows:
		for x in columns:
			var start := Vector2i((Vector2(x, y) * cell_size).round())
			var finish := Vector2i((Vector2(x + 1, y + 1) * cell_size).round())
			var cell := Rect2i(start, finish - start)
			var bounds := _opaque_bounds(source, cell)
			if not bounds.has_area():
				return []
			regions.append(bounds)
			max_height = maxi(max_height, bounds.size.y)
	var scale_value: float = sheet.height / max_height
	var frames: Array[Dictionary] = []
	for region in regions:
		var position := Vector2(region.position)
		var size := Vector2(region.size)
		var anchor := position + Vector2(size.x * 0.5, size.y)
		var eye := position + size * 0.5
		if sheet.id == "core_boss":
			eye = _magenta_center(source, region)
			anchor = eye
		var draw_rect := Rect2((position - anchor) * scale_value, size * scale_value)
		frames.append({"region": [region.position.x, region.position.y, region.size.x, region.size.y],
			"rect": [draw_rect.position.x, draw_rect.position.y, draw_rect.size.x, draw_rect.size.y],
			"anchor": [anchor.x, anchor.y], "center": [eye.x, eye.y]})
	return frames


func _opaque_bounds(source: Image, cell: Rect2i) -> Rect2i:
	var low := cell.end
	var high := cell.position - Vector2i.ONE
	for y in range(cell.position.y, cell.end.y):
		for x in range(cell.position.x, cell.end.x):
			if source.get_pixel(x, y).a <= 0.55:
				continue
			low = low.min(Vector2i(x, y))
			high = high.max(Vector2i(x, y))
	return Rect2i(low, high - low + Vector2i.ONE) if low.x <= high.x else Rect2i()


func _magenta_center(source: Image, region: Rect2i) -> Vector2:
	var centroid := Vector2.ZERO
	var count := 0.0
	for y in range(region.position.y, region.end.y):
		for x in range(region.position.x, region.end.x):
			var color := source.get_pixel(x, y)
			if color.a > 0.5 and color.r > 0.65 and color.b > 0.51 and color.g < color.r * 0.73:
				centroid += Vector2(x, y)
				count += 1.0
	return centroid / count if count > 10.0 else Vector2(region.get_center())


func _city_variants() -> bool:
	var base := Image.load_from_file(CITY)
	if base == null or base.is_empty():
		return false
	var extent := base.get_size()
	base.resize(extent.x / 4, extent.y / 4, Image.INTERPOLATE_BILINEAR)
	base.resize(extent.x, extent.y, Image.INTERPOLATE_BILINEAR)
	var night := base.duplicate()
	night.adjust_bcs(0.38, 1.0, 0.55)
	base.adjust_bcs(0.9, 1.0, 1.0)
	return night.save_png(ROOT + "city_below_night.png") == OK and base.save_png(ROOT + "city_below_dawn.png") == OK


func _write(path: String, data: String) -> bool:
	var file := FileAccess.open(path, FileAccess.WRITE)
	if file == null: return false
	file.store_string(data)
	file.close()
	return true


func _fail(message: String) -> void:
	push_error(message)
	quit(1)
